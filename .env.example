# Odoo integration — see README.md "Odoo integration" before filling these in.
# Not required for local dev or for the current build: nothing in the app
# reads these yet (src/lib/odoo.ts and src/lib/odoo-content.ts are written
# and typed, but not wired to any page).

# Base URL of the Odoo instance, no trailing slash.
ODOO_URL=https://your-instance.odoo.com

# Database name.
ODOO_DB=

# Login of the user the API key below belongs to. A dedicated read-only
# user is strongly preferred over a personal/admin login — see README.
ODOO_LOGIN=

# Generate under Odoo: Settings -> your profile -> Account Security ->
# New API Key. Used as the RPC password; never commit the real value.
ODOO_API_KEY=
