# Odoo integration — see README.md "Odoo integration" for full context.
#
# Pattern taken from the validated chaldeastudios/kilele_coffee reference,
# a working Next.js + Odoo 19 integration already live on this same
# Vercel account. Uses Odoo 19's External JSON-2 API
# (POST /json/2/<model>/<method>, `Authorization: bearer <api_key>`) —
# no session/login step, one credential covers everything this site reads.

# Base URL of the Odoo instance, no trailing slash.
ODOO_URL=https://your-instance.odoo.com

# Odoo database name.
ODOO_DB=

# Read-only API key (Odoo: Settings -> your profile -> Account Security ->
# New API Key). Everything this site reads from Odoo — services, project
# case studies, journal entries — is read-only content, so this single
# key covers all of it. Never commit the real value.
ODOO_API_KEY=

# --- Product checkout (only needed for /products/[slug]/checkout) ---------
#
# The checkout is the one write path on this site: it creates a res.partner
# and a confirmed sale.order so a free download is still a tracked sale and
# can feed Email Marketing. Everything else stays read-only.

# BOTH ARE OPTIONAL. With a single key above that can write (an admin key),
# the checkout already works: ODOO_WRITE_API_KEY falls back to ODOO_API_KEY,
# and CHECKOUT_SECRET derives from it. Set them to harden, not to enable.

# Write-scoped API key, so the credential that renders every public page
# cannot write anything.
ODOO_WRITE_API_KEY=

# Signs the expiring download links issued on order confirmation. Setting it
# explicitly lets the Odoo key be rotated without invalidating every
# outstanding download link. Generate with:  openssl rand -base64 32
CHECKOUT_SECRET=

# --- Paystack (priced products only) ---------------------------------------
#
# Paystack is called directly from this deployment, not through an Odoo
# module: Odoo Online (this site's backend) can't install custom Python
# code. See src/lib/checkout/paystack.ts. Without both of these, a priced
# order still gets created in Odoo as a draft, but no payment can be taken
# for it — the checkout tells the customer so rather than half-completing.

# Paystack -> Settings -> API Keys & Webhooks. Not a secret; sent to the
# browser to open the inline payment widget.
PAYSTACK_PUBLIC_KEY=

# Same page. Never sent to the browser — used only server-side, to verify a
# payment against Paystack's API and to check the webhook's signature.
PAYSTACK_SECRET_KEY=

# In the Paystack dashboard, set the webhook URL to:
#   https://<your-domain>/api/paystack/webhook
# This is what confirms an order if the customer closes the tab before the
# inline modal's own success callback fires.
